# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_STORAGE_BUCKET: The explicit bucket name for Storage.
# If not set, the server will fallback to firebase-applet-config.json
FIREBASE_STORAGE_BUCKET=""

# GOOGLE_MAPS_PLATFORM_KEY: Required for accurate distance routing calculations using Google Maps API.
GOOGLE_MAPS_PLATFORM_KEY=""

# GOOGLE_MAPS_API_KEY: Standard variable for Google Maps Platform services including Geocoding and Routes APIs.
GOOGLE_MAPS_API_KEY=""

# Brevo (formerly Sendinblue) API configuration for sending verification codes and system emails
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME=""
