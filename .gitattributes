# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare binary files so Git and GitHub handle them as binary images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary

# Explicitly declare web text files
*.html text
*.css text
*.js text
*.ts text
*.tsx text
*.json text
*.md text
*.svg text
