{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Represents a user in the SupplyX platform (Buyer, Supplier, or Logistics).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "userName": { "type": "string" },
        "nuit": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "moderator", "admin", "superadmin"] },
        "emailVerified": { "type": "boolean" },
        "type": { "type": "string", "enum": ["buyer", "supplier", "logistics"] },
        "sector": { "type": "string" },
        "city": { "type": "string" },
        "bio": { "type": "string" },
        "photoURL": { "type": "string" },
        "coverURL": { "type": "string" },
        "status": { "type": "string" },
        "lastActive": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "fleetSize": { "type": "string" },
        "specialization": { "type": "string" }
      },
      "required": ["uid", "name", "email", "type"]
    },
    "Chat": {
      "title": "Chat Room",
      "description": "Conversation between two or more participants.",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "lastMessageSenderId": { "type": "string" },
        "participantNames": { "type": "object" },
        "unreadCount": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants", "createdAt"]
    },
    "Message": {
      "title": "Chat Message",
      "description": "Individual message within a chat room.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" },
        "fileUrl": { "type": "string" },
        "fileType": { "type": "string" },
        "fileName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "participants", "text", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Product offered by a supplier with intelligent recognition support.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "normalizedName": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "unit": { "type": "string" },
        "category": { "type": "string" },
        "subcategory": { "type": "string" },
        "image": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "minOrder": { "type": "number" },
        "stock": { "type": "number" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "synonyms": { "type": "array", "items": { "type": "string" } },
        "searchIndex": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "supplierId", "createdAt"]
    },
    "Truck": {
      "title": "Truck",
      "description": "Vehicle registered by a logistics partner.",
      "type": "object",
      "properties": {
        "model": { "type": "string" },
        "plate": { "type": "string" },
        "type": { "type": "string" },
        "capacity": { "type": "string" },
        "status": { "type": "string", "enum": ["available", "in_transit", "maintenance"] },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["model", "plate", "ownerId"]
    },
    "Load": {
      "title": "Load",
      "description": "Cargo assigned to a logistics partner.",
      "type": "object",
      "properties": {
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "material": { "type": "string" },
        "weight": { "type": "string" },
        "status": { "type": "string" },
        "carrierId": { "type": "string" },
        "truckId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["origin", "destination", "material", "carrierId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System or user notification.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "senderId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "createdAt"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Request for Quotation document representing purchase negotiation.",
      "type": "object",
      "properties": {
        "buyerId": { "type": "string" },
        "supplierId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "responded", "accepted", "rejected", "cancelled"] },
        "items": { "type": "array", "items": { "type": "object" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["buyerId", "supplierId", "status", "items"]
    },
    "FreightOrder": {
      "title": "Freight Order / Cargo Request",
      "description": "Freight logistics order placed by a buyer or managed dynamically within the concourse.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tipoCarga": { "type": "string" },
        "quantidade": { "type": "string" },
        "origem": { "type": "string" },
        "destino": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "tipoCarga", "quantidade", "origem", "destino", "status"]
    },
    "Occurrence": {
      "title": "Occurrence / Incident",
      "description": "Logistics occurrences and incidents.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cargoId": { "type": "string" },
        "cargoName": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "dateTime": { "type": "string" },
        "responsible": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "cargoId", "cargoName", "description", "category", "dateTime", "responsible", "status"]
    },
    "TransportAssignment": {
      "title": "Transport Assignment",
      "description": "Represents a physical transport cargo assignment from the interactive spreadsheet with density calculation.",
      "type": "object",
      "properties": {
        "assignmentId": { "type": "string" },
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "products": { "type": "array", "items": { "type": "object" } },
        "totalWeight": { "type": "number" },
        "totalVolume": { "type": "number" },
        "density": { "type": "number" },
        "recommendedVehicle": { "type": "string" },
        "selectedVehicle": { "type": "string" },
        "transporterId": { "type": "string" },
        "driverId": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["assignmentId", "origin", "destination", "products", "totalWeight", "totalVolume", "status", "createdAt"]
    },
    "File": {
      "title": "Corporate File",
      "description": "Represents metadata of a corporate file attachment or uploaded document.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "file_name": { "type": "string" },
        "original_name": { "type": "string" },
        "file_type": { "type": "string" },
        "file_size": { "type": "number" },
        "storage_path": { "type": "string" },
        "blob_url": { "type": "string" },
        "uploaded_by": { "type": "string" },
        "company_id": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "message_id": { "type": "string" },
        "shipment_id": { "type": "string" },
        "product_id": { "type": "string" },
        "order_id": { "type": "string" },
        "transport_assignment_id": { "type": "string" },
        "category": { "type": "string" }
      },
      "required": ["id", "file_name", "original_name", "file_type", "file_size", "storage_path", "blob_url", "uploaded_by"]
    },
    "FileMetadata": {
      "title": "Uploaded File Metadata",
      "description": "Represents the metadata stored for uploaded chat attachments.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "extension": { "type": "string" },
        "size": { "type": "number" },
        "mimeType": { "type": "string" },
        "blobUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "userId": { "type": "string" },
        "roomId": { "type": "string" }
      },
      "required": ["id", "name", "extension", "size", "mimeType", "blobUrl", "userId", "roomId"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Profiles of registered users."
    },
    "admins/{userId}": {
      "schema": { "type": "object", "properties": { "role": { "type": "string" } } },
      "description": "Restricted collection for administrative roles. Only superadmins can write here."
    },
    "chats/{chatId}": {
      "schema": "Chat",
      "description": "Main chat room document."
    },
    "chats/{chatId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages belonging to a specific chat room."
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Products available in the marketplace."
    },
    "trucks/{truckId}": {
      "schema": "Truck",
      "description": "List of trucks available for logistics."
    },
    "loads/{loadId}": {
      "schema": "Load",
      "description": "Active and past loads."
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications."
    },
    "quotations/{quotationId}": {
      "schema": "Quotation",
      "description": "Quotation negotiations."
    },
    "freight_orders/{orderId}": {
      "schema": "FreightOrder",
      "description": "Freight logistics and cargo orders."
    },
    "occurrences/{occurrenceId}": {
      "schema": "Occurrence",
      "description": "Cargo delivery logs and incidents/occurrences."
    },
    "transportAssignments/{assignmentId}": {
      "schema": "TransportAssignment",
      "description": "Registered custom transport assignments calculated through interactive cubic weight layout."
    },
    "files/{fileId}": {
      "schema": "File",
      "description": "Metadata of corporate uploaded files."
    },
    "files_metadata/{fileId}": {
      "schema": "FileMetadata",
      "description": "Metadata of uploaded chat attachments."
    }
  }
}
