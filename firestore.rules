rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    

    // ---------------------------------------------------------
    // 1. GLOBAL HELPERS (PHASE 3)
    // ---------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn(); } 
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // RBAC: Trusted lookups (Pillar 4)
    // We use get() for role lookups. Note: get() costs 1 read.
    function getUserData(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function getAdminRole() { return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role; }
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || 
        ('email' in request.auth.token && request.auth.token.email.lower() == 'admin@supplyx.co.mz') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData(request.auth.uid).get('role', 'user') in ['admin', 'superadmin'])
      ); 
    }
    function isSuperAdmin() { 
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && getAdminRole() == 'superadmin') || 
        ('email' in request.auth.token && request.auth.token.email.lower() == 'admin@supplyx.co.mz') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData(request.auth.uid).get('role', 'user') == 'superadmin')
      ); 
    }

    // ---------------------------------------------------------
    // 2. VALIDATION BLUEPRINTS (Pillar 2)
    // ---------------------------------------------------------
    
    function isValidUser(data, isUpdate) {
      return (!('uid' in data) || data.uid == request.auth.uid) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 256)) &&
             (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 256)) &&
             (!('userName' in data) || data.userName == null || (data.userName is string && data.userName.size() <= 256)) &&
             (!('nuit' in data) || data.nuit == null || (data.nuit is string && data.nuit.size() <= 100)) &&
             (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 1024)) &&
             (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 100)) &&
             (!('city' in data) || data.city == null || (data.city is string && data.city.size() <= 256)) &&
             (!('sector' in data) || data.sector == null || (data.sector is string && data.sector.size() <= 256)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 5000)) &&
             // Pillar 11: Base64 Fallback support (1MB limit for Firestore doc)
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1100000)) &&
             (!('coverURL' in data) || data.coverURL == null || (data.coverURL is string && data.coverURL.size() <= 1100000)) &&
             (!('license' in data) || data.license == null || (data.license is string && data.license.size() <= 256)) &&
             (!('bankAccounts' in data) || data.bankAccounts is list) && 
             (!('mobileWallets' in data) || data.mobileWallets is list) &&
             (!('specialization' in data) || data.specialization == null || (data.specialization is string && data.specialization.size() <= 256)) &&
             (!('fleetSize' in data) || data.fleetSize == null || (data.fleetSize is string && data.fleetSize.size() <= 128)) &&
             (!('type' in data) || data.type in ['buyer', 'supplier', 'logistics']) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50));
    }

    function isValidChat(data) {
      return data.keys().hasAll(['participants']) &&
             data.participants is list && data.participants.size() >= 2 && data.participants.size() <= 10 &&
             data.participants.hasAny([request.auth.uid]) &&
             (data.get('createdAt', null) == request.time || data.get('updatedAt', null) == request.time);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'participants', 'text']) &&
             data.senderId == request.auth.uid &&
             data.participants is list &&
             data.participants.hasAny([request.auth.uid]) &&
             data.text is string && data.text.size() <= 5000 &&
             (data.get('createdAt', null) == request.time || data.get('updatedAt', null) == request.time);
    }

    function isValidProduct(data, isUpdate) {
      return data.keys().hasAll(['name', 'price', 'supplierId']) &&
             (isAdmin() || data.supplierId == request.auth.uid) &&
             data.price is number && 
             data.name is string && data.name.size() <= 200 &&
             (!('image' in data) || (data.image is string && data.image.size() <= 1100000)) &&
             (!('normalizedName' in data) || (data.normalizedName is string && data.normalizedName.size() <= 200)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 50)) &&
             (isUpdate ? true : data.createdAt == request.time);
    }

    function isValidTruck(data) {
      return data.keys().hasAll(['model', 'plate', 'ownerId']) &&
             data.ownerId == request.auth.uid &&
             data.model is string && data.model.size() <= 100 &&
             data.plate is string && data.plate.size() <= 20;
    }

    function isValidLoad(data) {
      return data.keys().hasAll(['origin', 'destination', 'material', 'carrierId']) &&
             data.carrierId == request.auth.uid &&
             data.origin is string && data.origin.size() <= 200 &&
             data.destination is string && data.destination.size() <= 200;
    }

    function isValidQuotation(data) {
      return data.keys().hasAll(['buyerId', 'supplierId', 'status', 'items']) &&
             data.buyerId is string && data.supplierId is string &&
             data.status in ['pending', 'responded', 'accepted', 'rejected', 'cancelled'] &&
             data.items is list &&
             (data.get('createdAt', null) == request.time || data.get('updatedAt', null) == request.time);
    }

    function isValidFreightOrder(data) {
      return data.keys().hasAll(['id', 'tipoCarga', 'quantidade', 'origem', 'destino', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.tipoCarga is string && data.tipoCarga.size() <= 500 &&
             data.quantidade is string && data.quantidade.size() <= 200 &&
             data.origem is string && data.origem.size() <= 1000 &&
             data.destino is string && data.destino.size() <= 1000 &&
             data.status is string && data.status.size() <= 100;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 2000 &&
             data.createdAt == request.time;
    }

    function isValidOccurrence(data) {
      return data.keys().hasAll(['id', 'cargoId', 'cargoName', 'description', 'category', 'dateTime', 'responsible', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.cargoId is string && data.cargoId.size() <= 128 &&
             data.cargoName is string && data.cargoName.size() <= 500 &&
             data.description is string && data.description.size() <= 5000 &&
             data.category is string && data.category.size() <= 100 &&
             data.dateTime is string && data.dateTime.size() <= 100 &&
             data.responsible is string && data.responsible.size() <= 200 &&
             data.status is string && data.status.size() <= 50;
    }

    function isValidTransportAssignment(data) {
      return data.keys().hasAll(['assignmentId', 'origin', 'destination', 'products', 'totalWeight', 'totalVolume', 'status', 'createdAt']) &&
             data.assignmentId is string && data.assignmentId.size() <= 128 &&
             data.origin is string && data.origin.size() <= 500 &&
             data.destination is string && data.destination.size() <= 500 &&
             data.products is list &&
             data.totalWeight is number &&
             data.totalVolume is number &&
             data.status is string && data.status.size() <= 100;
    }

    function isValidFile(data) {
      return data.keys().hasAll(['id', 'file_name', 'original_name', 'file_type', 'file_size', 'storage_path', 'blob_url', 'uploaded_by']) &&
             data.id is string &&
             data.file_name is string && data.file_name.size() <= 500 &&
             data.original_name is string && data.original_name.size() <= 500 &&
             data.file_type is string &&
             data.file_size is number &&
             data.storage_path is string &&
             data.blob_url is string &&
             data.uploaded_by is string;
    }

    function isValidFileMetadata(data) {
      return data.userId == request.auth.uid;
    }

    // ---------------------------------------------------------
    // 3. MATCH BLOCKS (Hardened)
    // ---------------------------------------------------------
    
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidUser(incoming(), false);
      allow update: if isSignedIn() && (
        isAdmin() || 
        (request.auth.uid == userId && isValidUser(incoming(), true))
      );
      allow delete: if isAdmin();
    }

    // ADMINS: Highly restricted (Pillar 6)
    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // CHATS: (Pillar 1 - Relational Sync)
    match /chats/{chatId} {
      allow list: if isSignedIn() && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
      allow get: if isSignedIn() && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
      allow create: if isVerified() && isValidChat(incoming());
      allow update: if isVerified() && (existing().participants.hasAny([request.auth.uid]) || isAdmin()) && (
         incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'updatedAt', 'participantNames', 'unreadCount'])
      );
      allow delete: if isVerified() && (existing().participants.hasAny([request.auth.uid]) || isAdmin());

      match /messages/{messageId} {
        allow list: if isSignedIn() && (get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) || isAdmin());
        allow create: if isVerified() && isValidMessage(incoming()) && (get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) || isAdmin());
        allow update: if isVerified() && (get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) || isAdmin());
        allow delete: if isVerified() && (request.auth.uid == existing().senderId || isAdmin());
      }
    }

    // PRODUCTS:
    match /products/{productId} {
      allow read, write: if true;
    }

    // TRUCKS:
    match /trucks/{truckId} {
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(truckId) && isValidTruck(incoming());
      allow update: if isVerified() && (existing().ownerId == request.auth.uid || isAdmin()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['model', 'plate', 'type', 'capacity', 'status'])
      );
      allow delete: if isVerified() && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // LOADS:
    match /loads/{loadId} {
      allow list: if isSignedIn() && (resource.data.carrierId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.carrierId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(loadId) && isValidLoad(incoming());
      allow update: if isVerified() && (existing().carrierId == request.auth.uid || isAdmin()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'truckId', 'updatedAt'])
      );
      allow delete: if isVerified() && (existing().carrierId == request.auth.uid || isAdmin());
    }

    // NOTIFICATIONS:
    match /notifications/{notificationId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidNotification(incoming());
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['read', 'deleted'])
      );
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // QUOTATIONS:
    match /quotations/{quotationId} {
      allow list: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.supplierId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.supplierId == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidQuotation(incoming());
      allow update: if isVerified() && (existing().buyerId == request.auth.uid || existing().supplierId == request.auth.uid || isAdmin());
      allow delete: if isVerified() && (existing().buyerId == request.auth.uid || existing().supplierId == request.auth.uid || isAdmin());
    }

    // FREIGHT ORDERS:
    match /freight_orders/{orderId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isVerified() && isValidFreightOrder(incoming());
      allow update: if isVerified() && isValidFreightOrder(incoming());
      allow delete: if isVerified();
    }

    // OCCURRENCES:
    match /occurrences/{occurrenceId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isVerified() && isValidOccurrence(incoming());
      allow update: if isVerified() && isValidOccurrence(incoming());
      allow delete: if isVerified();
    }

    // TRANSPORT ASSIGNMENTS:
    match /transportAssignments/{assignmentId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isVerified() && isValidTransportAssignment(incoming());
      allow update: if isVerified() && isValidTransportAssignment(incoming());
      allow delete: if isVerified();
    }

    // FILES:
    match /files/{fileId} {
      allow read, write: if true;
    }

    // FILE AUDITS:
    match /file_audits/{auditId} {
      allow read, write: if true;
    }

    // EMAIL VERIFICATIONS:
    match /email_verifications/{email} {
      allow read, write: if true;
    }

    // FILES METADATA:
    match /files_metadata/{fileId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isVerified() && isValidFileMetadata(incoming());
      allow update: if isVerified() && (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isVerified() && (existing().userId == request.auth.uid || isAdmin());
    }

    // PRODUCT SYNONYMS:
    match /ProductSynonyms/{synonymId} {
      allow read, write: if true;
    }

    // SYNONYM SUGGESTIONS:
    match /SynonymSuggestions/{suggestionId} {
      allow read, write: if true;
    }

    // CARRIER BIDS:
    match /carrier_bids/{bidId} {
      allow read, write: if true;
    }
  }
}
