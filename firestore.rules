rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // GLOBAL HELPERS
    // ---------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // ---------------------------------------------------------
    // VALIDATION BLUEPRINTS
    // ---------------------------------------------------------
    
    function isCreating() { return resource == null; }
    function isUpdating() { return resource != null; }

    function isValidUser(data) {
      return (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 128)) &&
             (!('type' in data) || (data.type in ['buyer', 'supplier', 'logistics'])) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
             (!('nuit' in data) || (data.nuit is string && data.nuit.size() <= 20)) &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('sector' in data) || (data.sector is string && data.sector.size() <= 100)) &&
             (!('updatedAt' in data) || (isCreating() ? data.updatedAt == request.time : (data.updatedAt == request.time || data.updatedAt == existing().updatedAt)));
    }

    function isValidChat(data) {
      return data.keys().hasAll(['participants', 'createdAt', 'updatedAt']) &&
             data.participants is list && data.participants.size() >= 2 &&
             request.auth.uid in data.participants &&
             (isCreating() ? data.createdAt == request.time : data.createdAt == existing().createdAt) &&
             data.updatedAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['senderId', 'participants', 'text', 'createdAt']) &&
             data.senderId == request.auth.uid &&
             request.auth.uid in data.participants &&
             data.text is string && data.text.size() <= 5000 &&
             (isCreating() ? data.createdAt == request.time : data.createdAt == existing().createdAt);
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'supplierId', 'createdAt']) &&
             data.supplierId == request.auth.uid &&
             data.price is number && data.price >= 0 &&
             data.name is string && data.name.size() <= 200 &&
             (isCreating() ? data.createdAt == request.time : data.createdAt == existing().createdAt);
    }

    function isValidTruck(data) {
      return data.keys().hasAll(['model', 'plate', 'ownerId', 'status']) &&
             data.ownerId == request.auth.uid &&
             data.model is string && data.model.size() <= 100 &&
             data.plate is string && data.plate.size() <= 20 &&
             data.status in ['available', 'in_transit', 'maintenance'];
    }

    function isValidLoad(data) {
      return data.keys().hasAll(['origin', 'destination', 'material', 'carrierId', 'status']) &&
             data.carrierId == request.auth.uid &&
             data.origin is string && data.origin.size() <= 200 &&
             data.destination is string && data.destination.size() <= 200 &&
             data.status is string;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'createdAt', 'read']) &&
             (!('senderId' in data) || data.senderId == request.auth.uid) &&
             (data.userId == request.auth.uid || (isSignedIn() && 'senderId' in data)) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 2000 &&
             (isCreating() ? data.createdAt == request.time : data.createdAt == existing().createdAt) &&
             data.read is bool;
    }

    // ---------------------------------------------------------
    // MATCH BLOCKS
    // ---------------------------------------------------------
    
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /chats/{chatId} {
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow get: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && isValidChat(incoming());
      allow update: if isSignedIn() && request.auth.uid in existing().participants && (
        // Action: Last Message Sync
        incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastMessageSenderId', 'updatedAt', 'participantNames'])
      );

      match /messages/{messageId} {
        allow list: if isSignedIn() && request.auth.uid in resource.data.participants;
        allow get: if isSignedIn() && request.auth.uid in resource.data.participants;
        allow create: if isSignedIn() && isValidMessage(incoming());
      }
    }

    match /products/{productId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isSignedIn() && isValidId(productId) && existing().supplierId == request.auth.uid && isValidProduct(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'price', 'unit', 'category', 'image', 'stock', 'updatedAt', 'minOrder', 'supplierName', 'onSale', 'salePrice'])
      );
      allow delete: if isSignedIn() && existing().supplierId == request.auth.uid;
    }

    match /trucks/{truckId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(truckId) && isValidTruck(incoming());
      allow update: if isSignedIn() && isValidId(truckId) && existing().ownerId == request.auth.uid && isValidTruck(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['model', 'plate', 'type', 'capacity', 'status'])
      );
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    match /loads/{loadId} {
      allow list: if isSignedIn() && resource.data.carrierId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.carrierId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(loadId) && isValidLoad(incoming());
      allow update: if isSignedIn() && isValidId(loadId) && existing().carrierId == request.auth.uid && isValidLoad(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'truckId', 'updatedAt'])
      );
    }

    match /notifications/{notificationId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && (
        incoming().diff(existing()).affectedKeys().hasOnly(['read'])
      );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
